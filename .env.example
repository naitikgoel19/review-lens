# Review Lens — Example Environment Configuration
# Copy to .env and configure for your environment

APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database / Storage Configuration
DATA_STORAGE_PATH=./data/seed_data.json

# Microsoft Entra ID / SSO Placeholder Configuration
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Global Company Data Provider API (OpenCorporates)
OPENCORPORATES_API_TOKEN=
COMPANY_DATA_API_KEY=
COMPANY_DATA_API_PROVIDER=opencorporates
